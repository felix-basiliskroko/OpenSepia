# =============================================================================
# LLM Providers — which coding CLI runs each agent
# Assign per agent in config/agents.yaml (`provider:`) or override here with
# AGENT_PROVIDER_<AGENT_ID>. Spreading agents over several subscriptions
# avoids exhausting a single plan's rate limit.
#   claude   Claude Code CLI   — Anthropic Pro/Max        (claude login)
#   codex    OpenAI Codex CLI  — ChatGPT Plus/Pro         (codex login)
#   minimax  Claude Code CLI   — MiniMax Coding Plan key
# =============================================================================

# ----- Per-agent overrides (highest precedence) -----
# AGENT_PROVIDER_PO=claude
# AGENT_PROVIDER_PM=claude
# AGENT_PROVIDER_DEV1=claude
# AGENT_PROVIDER_DEV2=codex
# AGENT_PROVIDER_DEVOPS=codex
# AGENT_PROVIDER_TESTER=minimax
# AGENT_PROVIDER_SEC_ANALYST=minimax
# AGENT_PROVIDER_SEC_ENGINEER=minimax
# AGENT_PROVIDER_SEC_PENTESTER=minimax

# ----- Anthropic / Claude Code (subscription via `claude login`) -----
# Optional model pin for claude-backed agents:
# CLAUDE_MODEL=opus

# ----- OpenAI Codex (subscription via `codex login`, NOT an API key) -----
# Sandbox for agent-run commands: read-only | workspace-write | danger-full-access
# CODEX_SANDBOX=workspace-write
# CODEX_MODEL=gpt-5-codex
# OPENAI_API_KEY is dropped from the agent env so the ChatGPT plan is used.
# Set this to bill the API instead:
# CODEX_PREFER_API_KEY=false

# ----- MiniMax Coding Plan (Anthropic-compatible endpoint) -----
# Coding Plan subscription key from platform.minimax.io (not a pay-per-token key)
# MINIMAX_API_KEY=INSERT-CODING-PLAN-KEY-HERE
# International: https://api.minimax.io/anthropic  | China: https://api.minimaxi.com/anthropic
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# MINIMAX_MODEL=MiniMax-M3[1m]

# ----- Shared -----
# Per-agent wall-clock limit in seconds (default 900)
# AGENT_TIMEOUT_SECONDS=900

# =============================================================================
# Board Provider — choose ONE provider (GitLab OR GitHub)
# Auto-detection: the system automatically detects based on set env vars.
# =============================================================================

# ----- GitLab -----
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-INSERT-TOKEN-HERE
GITLAB_PROJECT_ID=group/project-name

# ----- GitHub (alternative to GitLab) -----
# GITHUB_TOKEN=ghp_INSERT-TOKEN-HERE
# GITHUB_OWNER=my-org
# GITHUB_REPO=my-project
# GITHUB_API_URL=https://api.github.com  # optional, for GitHub Enterprise

# =============================================================================
# Git (for the Developer agent)
# =============================================================================
GIT_REPO_URL=https://gitlab.com/group/project-name.git
GIT_REPO_PATH=./repo
GIT_USER_NAME=AI Dev Team
GIT_USER_EMAIL=ai-team@company.com
GIT_MAIN_BRANCH=main
GIT_AUTO_PUSH=true
# For HTTPS auth (preferred):
GIT_TOKEN=glpat-INSERT-TOKEN-HERE
# For SSH auth:
# GIT_SSH_KEY=/root/.ssh/id_ed25519

# =============================================================================
# Docker (for the DevOps agent - runs inside LXC)
# =============================================================================
# Docker socket (if not default)
# DOCKER_HOST=unix:///var/run/docker.sock

# Registry for push/pull (optional)
# DOCKER_REGISTRY=registry.gitlab.com
# DOCKER_REGISTRY_USER=deploy-token
# DOCKER_REGISTRY_PASS=token-password

# Prefix for image names (optional)
# DOCKER_IMAGE_PREFIX=mycompany/

# Docker-compose file (default: docker-compose.yml)
# DOCKER_COMPOSE_FILE=docker-compose.yml

# Security limits
DOCKER_MAX_CONTAINERS=10
DOCKER_ALLOWED_NETWORKS=bridge,host
